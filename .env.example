# Application
APP_NAME=VideoAnalyticsPlatform
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
BACKEND_RELOAD=true

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=video_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
DATABASE_URL=postgresql+asyncpg://postgres:postgres123@postgres:5432/video_analytics

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://admin:admin123@rabbitmq:5672/

# Elasticsearch
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://elasticsearch:9200

# MinIO (Object Storage)
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=video-analytics
MINIO_URL=minio:9000
MINIO_SECURE=false

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
RATE_LIMIT_PER_MINUTE=60
BCRYPT_ROUNDS=12

# Inference
INFERENCE_DEVICE=cuda  # cuda or cpu
INFERENCE_BATCH_SIZE=4
INFERENCE_FP16=true
INFERENCE_WORKERS=2
MODEL_PATH=/app/models

# Stream Processing
FRAME_SAMPLING_FPS=5
FRAME_QUEUE_MAX_SIZE=1000
STREAM_BUFFER_SECONDS=30
HLS_SEGMENT_DURATION=4

# Camera
CAMERA_CONNECTION_TIMEOUT=10
CAMERA_PROBE_TIMEOUT=5
CAMERA_RECONNECT_INTERVAL=30

# Rule Engine
RULE_EVALUATION_INTERVAL=0.1
RULE_STATE_TTL=300

# Alerts
ALERT_SNAPSHOT_ENABLED=true
ALERT_CLIP_ENABLED=true
ALERT_CLIP_DURATION=10
ALERT_RETENTION_DAYS=30

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
METRICS_ENABLED=true

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_HLS_BASE_URL=http://localhost:8000/streams

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@securein.com

# Slack (Optional)
SLACK_WEBHOOK_URL=

# S3 (Production - Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Feature Flags
ENABLE_FACE_RECOGNITION=true
ENABLE_LPR=true
ENABLE_ANOMALY_DETECTION=false
ENABLE_ELASTICSEARCH=true
