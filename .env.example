# Backend Configuration
DATABASE_URL=postgresql+asyncpg://videoadmin:videopass123@localhost:5432/videodb
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# MinIO/S3 Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=video-analytics
MINIO_SECURE=false

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:9200

# Security
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# GPU Configuration
GPU_ENABLED=true
INFERENCE_BATCH_SIZE=8
SAMPLING_RATE_FPS=5

# Model Configuration
MODEL_PATH=/app/models
DETECTOR_MODEL=yolov8n
FACE_MODEL=facenet
LPR_MODEL=alpr

# Camera Configuration
DEFAULT_CAMERA_FPS=25
DEFAULT_CAMERA_RESOLUTION=1920x1080
RING_BUFFER_SECONDS=30

# Alert Configuration
ALERT_RETENTION_DAYS=90
CLIP_DURATION_SECONDS=10

# Performance
MAX_WORKERS=4
QUEUE_MAX_SIZE=1000

# Logging
LOG_LEVEL=INFO

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
